{
  "name": "sensor-gateway",
  "version": "1.0.0",
  "description": "GraphQL gateway for sensor gRPC service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "generate-proto": "protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./src/grpc/generated --ts_proto_opt=outputClientImpl=grpc-js,esModuleInterop=true -I ./src/grpc/proto ./src/grpc/proto/sensor.proto"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.10",
    "apollo-server": "^3.13.0",
    "graphql": "^16.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "ts-proto": "^1.165.0",
    "typescript": "^5.3.3"
  }
}